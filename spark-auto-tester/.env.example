# The Spark webhook already has a working default in chatbot-tester.config.json.
# Change this only if your URL changes.
CHATBOT_WEBHOOK_URL=https://n8n.srv917960.hstgr.cloud/webhook/spark-chatbot
CHATBOT_WEBHOOK_METHOD=GET

# Main cycle size
TEST_COUNT=100

# IMPORTANT: sequential means exactly one request at a time.
MAX_CONCURRENT_REQUESTS=1
REQUESTS_PER_SECOND=1
DELAY_BETWEEN_REQUESTS_MS=250
REQUEST_TIMEOUT_MS=30000
MAX_RETRIES=3

SIMILARITY_THRESHOLD=0.85
ENABLE_NEGATIVE_TESTS=true
ENABLE_HALLUCINATION_TESTS=true
ENABLE_PROMPT_INJECTION_TESTS=true
ENABLE_EDGE_CASES=true
ENABLE_MULTI_TURN_TESTS=true
ENABLE_REGRESSION_TESTS=true

# Optional AI enhancement for generation/evaluation/improvement synthesis.
# The system still runs without this and uses deterministic evidence-based evaluation.
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TEMPERATURE=0
AI_REQUEST_TIMEOUT_MS=45000
